{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Medaris base",
  "//": "ADR-001 §D7: strict, NodeNext, NO paths aliases anywhere. Cross-package resolution goes through pnpm's node_modules links (workspace:*), not tsconfig paths. NestJS packages restore their commonjs + decorator settings in their own tsconfig.json — see docs/migration/mdrs-10-pnpm-workspace.md §5.",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "force",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "incremental": false
  },
  "exclude": ["node_modules", "dist"]
}

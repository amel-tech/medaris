      "$type": "shadow",
      "$name": "--shadow-player"
    },
    "dialog": {
      "$value": "0 30px 60px -20px rgba(15,23,42,0.4)",
      "$type": "shadow",
      "$name": "--shadow-dialog"
    }
  },
  "scrim": {
    "dialog": {
      "$value": "rgba(15,23,42,0.55)",
      "$type": "color",
      "$name": "--scrim-dialog"
    },
    "media": {
      "$value": "linear-gradient(transparent, rgba(0,0,0,0.75))",
      "$type": "other",
      "$name": "--scrim-media"
    },
    "media40": {
      "$value": "linear-gradient(transparent 40%, rgba(0,0,0,0.45))",
      "$type": "other",
      "$name": "--scrim-media-40"
    }
  },
  "duration": {
    "fast": {
      "$value": "150ms",
      "$type": "duration",
      "$name": "--dur-fast"
    },
    "base": {
      "$value": "200ms",
      "$type": "duration",
      "$name": "--dur-base"
    }
  },
  "easing": {
    "standard": {
      "$value": "ease",
      "$type": "cubicBezier",
      "$name": "--ease-standard"
    }
  },
  "transition": {
    "hover": {
      "$value": "border-color var(--dur-fast) var(--ease-standard), background-color var(--dur-fast) var(--ease-standard), color var(--dur-fast) var(--ease-standard)",
      "$type": "transition",
      "$name": "--transition-hover",
      "$description": "hover tint on buttons, pills, cards, sidebar rows"
    },
    "disclosure": {
      "$value": "transform var(--dur-base) var(--ease-standard)",
      "$type": "transition",
      "$name": "--transition-disclosure",
      "$description": "accordion chevron rotation"
    },
    "rail": {
      "$value": "grid-template-columns var(--dur-base) var(--ease-standard)",
      "$type": "transition",
      "$name": "--transition-rail",
      "$description": "sidebar / rail collapse"
    }
  }
}

{"namespace":"MedarisDesignSystem_628e07","components":[{"name":"Alert","sourcePath":"components/Alert.jsx"},{"name":"AppBar","sourcePath":"components/AppBar.jsx"},{"name":"Avatar","sourcePath":"components/Avatar.jsx"},{"name":"AvatarStack","sourcePath":"components/AvatarStack.jsx"},{"name":"Badge","sourcePath":"components/Badge.jsx"},{"name":"Breadcrumb","sourcePath":"components/Breadcrumb.jsx"},{"name":"Button","sourcePath":"components/Button.jsx"},{"name":"Card","sourcePath":"components/Card.jsx"},{"name":"Checkbox","sourcePath":"components/Checkbox.jsx"},{"name":"ChoiceChips","sourcePath":"components/ChoiceChips.jsx"},{"name":"CoverPattern","sourcePath":"components/CoverPattern.jsx"},{"name":"Dialog","sourcePath":"components/Dialog.jsx"},{"name":"EmptyState","sourcePath":"components/EmptyState.jsx"},{"name":"Field","sourcePath":"components/Field.jsx"},{"name":"Icon","sourcePath":"components/Icon.jsx"},{"name":"IconButton","sourcePath":"components/IconButton.jsx"},{"name":"Input","sourcePath":"components/Input.jsx"},{"name":"LessonRow","sourcePath":"components/LessonRow.jsx"},{"name":"Logo","sourcePath":"components/Logo.jsx"},{"name":"NavItem","sourcePath":"components/NavItem.jsx"},{"name":"NavSection","sourcePath":"components/NavSection.jsx"},{"name":"PlatformChip","sourcePath":"components/PlatformChip.jsx"},{"name":"Progress","sourcePath":"components/Progress.jsx"},{"name":"Radio","sourcePath":"components/Radio.jsx"},{"name":"RadioGroup","sourcePath":"components/RadioGroup.jsx"},{"name":"Select","sourcePath":"components/Select.jsx"},{"name":"SessionJoin","sourcePath":"components/SessionJoin.jsx"},{"name":"Skeleton","sourcePath":"components/Skeleton.jsx"},{"name":"Stat","sourcePath":"components/Stat.jsx"},{"name":"Switch","sourcePath":"components/Switch.jsx"},{"name":"SystemState","sourcePath":"components/SystemState.jsx"},{"name":"Table","sourcePath":"components/Table.jsx"},{"name":"Tabs","sourcePath":"components/Tabs.jsx"},{"name":"Textarea","sourcePath":"components/Textarea.jsx"},{"name":"Toast","sourcePath":"components/Toast.jsx"},{"name":"Toaster","sourcePath":"components/Toaster.jsx"},{"name":"Tooltip","sourcePath":"components/Tooltip.jsx"},{"name":"WeekAccordion","sourcePath":"components/WeekAccordion.jsx"}],"startingPoints":[],"cards":[{"path":"components/button.card.html","group":"Actions","viewport":"880x1260","subtitle":"Six variants at rest, hover, focus and disabled; heights 24 / 32 / 40 / 48; a link, busy, icons, the icon button with its tooltip, confirmation footers and the full-width phone button","name":"Button"},{"path":"components/logo.card.html","group":"Brand","viewport":"880x600","subtitle":"The Medaris mark: two arch halves on a lâciverd ground, the same by day and by night; the large lockup adds مدارس","name":"Logo"},{"path":"components/avatar-progress.card.html","group":"Data display","viewport":"820x640","subtitle":"A person is a paper circle with muted initials; an institution is a small bookcloth tile. A 6px track with a lâciverd bar. A skeleton shaped like the lines that are coming","name":"Avatar, progress, skeleton"},{"path":"components/badge.card.html","group":"Data display","viewport":"760x860","subtitle":"A 24px status label in two families: what a thing is, and how it is going; glyphs, counted enrolment badges in a Nizam course row, and the Arabic interface","name":"Badge"},{"path":"components/card.card.html","group":"Data display","viewport":"820x700","subtitle":"A paper sheet with a hairline and no shadow; a bookcloth band on top, a meta footer, a whole-card link in the Literata title; Stat with its cue","name":"Card"},{"path":"components/table.card.html","group":"Data display","viewport":"1200x1320","subtitle":"A ledger in a paper frame: hairline rows, figures lined up, sortable headers, the course cell with its cloth swatch, counted enrolment badges; empty, loading and error; at 390 each row stacks as a card","name":"Table"},{"path":"components/alert.card.html","group":"Feedback","viewport":"760x724","subtitle":"Five tones on their tints: the glyph and the title carry the tone, the words stay in ink. Neutral explains or restricts, info reports news, success confirms, warning asks the reader to act, error reports a failure","name":"Alert"},{"path":"components/empty-state.card.html","group":"Feedback","viewport":"900x960","subtitle":"An empty list says in one sentence what is missing, with at most one action. A page that is only a state is set in Literata; the device restriction has the large lockup, the owner's two sentences and no way out","name":"Empty and system states"},{"path":"components/overlay.card.html","group":"Feedback","viewport":"980x1206","subtitle":"Everything that floats. Dialogs are paper on elevation-modal with the page-coloured desk as their footer; each shows where focus starts. Toasts sit in the toaster's two live regions; the tooltip is a paper slip","name":"Dialog, toast, tooltip"},{"path":"components/choice-chips.card.html","group":"Forms","viewport":"760x730","subtitle":"Native radios or checkboxes drawn as 32px chips: a list filter, a form field such as the weekdays, glyphs, every state, and the Arabic interface","name":"Choice chips"},{"path":"components/input.card.html","group":"Forms","viewport":"820x1540","subtitle":"A field and a text box: 40px (32 in a compact region), a 6px corner and a 3:1 ink edge. Every state, inside a field, four sizes and the Arabic interface.","name":"Input"},{"path":"components/select.card.html","group":"Forms","viewport":"820x1100","subtitle":"The native select in a field box: a time zone, a medrese, a filter. Four to fifteen options; every state, four sizes and the Arabic interface.","name":"Select"},{"path":"components/selection.card.html","group":"Forms","viewport":"820x1510","subtitle":"An 18px mark, a 36×20 switch, a label at least 24px tall. Checked and on are the action ink. Every state, settings rows, inside a form and the Arabic interface.","name":"Checkbox, radio, switch"},{"path":"components/icon.card.html","group":"Foundations","viewport":"1040x940","subtitle":"Phosphor Regular from one sprite, in currentColor: an icon takes the text role of its place; fill only as a state; arrows and chevrons mirror in RTL","name":"Icons"},{"path":"foundations/color-domain.card.html","group":"Foundations","viewport":"820x850","subtitle":"Bookcloth covers, platform dots, the logo, the rating star and the media scrim. They read the same by day and by night.","name":"Domain colour"},{"path":"foundations/color-grammar.card.html","group":"Foundations","viewport":"820x1340","subtitle":"--{property}-{tone}-{variant}. The number of roles has a ceiling that rises only by decision. Each variant carries a contrast promise that verify-contrast.mjs proves in both themes.","name":"Colour grammar"},{"path":"foundations/color-primitives.card.html","group":"Foundations","viewport":"820x770","subtitle":"Six ramps: paper, ink, lapis, red ink, saffron, emerald. Only tokens/*.css names a step; a component reads a semantic role.","name":"Colour ramps"},{"path":"foundations/color-semantic-background.card.html","group":"Foundations","viewport":"820x1310","subtitle":"Six grounds text can sit on, the ink action fill, and a tint and a fill for each tone. Each row names its day step and its night step.","name":"Semantic — background"},{"path":"foundations/color-semantic-border.card.html","group":"Foundations","viewport":"820x1000","subtitle":"A hairline decorates, a control edge identifies, a tone edge marks. Two widths: 1px for every edge, 2px for the active tab and a selected choice.","name":"Semantic — border"},{"path":"foundations/color-semantic-text.card.html","group":"Foundations","viewport":"820x1070","subtitle":"Every text role with its lowest ratio on any ground, by day and by night. An icon has no colour of its own: it takes the text role of its context.","name":"Semantic — text"},{"path":"foundations/contrast-audit.card.html","group":"Foundations","viewport":"820x1430","subtitle":"Every colour pair the system promises passes in both themes. There are no open accessibility decisions. The full table is contrast.md.","name":"Contrast"},{"path":"foundations/elevation.card.html","group":"Foundations","viewport":"820x570","subtitle":"Nothing at rest casts a shadow: a resting surface is a hairline. Only floating layers lift. Shadows are ink-tinted by day, black with a 1px ring by night.","name":"Elevation"},{"path":"foundations/focus.card.html","group":"Foundations","viewport":"820x1100","subtitle":"One ring, two bands: a 2px gap in paper (ink at night), then a 2px lapis ring. At least 5.38:1 by day and 7.07:1 by night, on ink, paper and red alike (MDS-A11Y-01).","name":"Focus ring"},{"path":"foundations/layout.card.html","group":"Foundations","viewport":"820x980","subtitle":"Tedris reads in a 1200px column with a 344px aside under a 64px top bar; Nizam runs full width beside a 256px sidebar. Three breakpoints, one prose measure.","name":"Layout"},{"path":"foundations/motion.card.html","group":"Foundations","viewport":"820x580","subtitle":"Two durations and one easing. Only colour, the switch knob and a disclosure move; nothing enters, lifts or scales. Reduced motion is one global rule (MDS-MOT-01).","name":"Motion"},{"path":"foundations/radius-borders.card.html","group":"Foundations","viewport":"820x640","subtitle":"Books are nearly square: five radii by role, and nothing is a pill unless it is round by nature. Every edge is 1px; 2px marks only the active tab and a selected choice (MDS-SHAPE-01).","name":"Shape"},{"path":"foundations/spacing.card.html","group":"Foundations","viewport":"820x1090","subtitle":"--space-N is N × 4px. Density is a region, not an app: data-density=compact re-points the roles, from card padding down to table cells (MDS-LAY-02).","name":"Space and density"},{"path":"foundations/theme-night.card.html","group":"Foundations","viewport":"820x1240","subtitle":"The same screen by day and by night. The night theme swaps paper and ink; it re-points semantic roles only, never a primitive.","name":"Night theme"},{"path":"foundations/type-arabic.card.html","group":"Foundations","viewport":"820x1090","subtitle":"Classical text at 26/2.0, an inline word at 1.2em, and the whole Arabic interface one step larger and one weight heavier. A Latin island inside it returns to its Latin size (MDS-TYPE-04).","name":"Arabic — Noto Naskh Arabic"},{"path":"foundations/type-body.card.html","group":"Foundations","viewport":"820x820","subtitle":"Instrument Sans at 14 for every control and 16 for running text; Literata 18/1.7 for reading; Atkinson Hyperlegible Mono for links and IDs (MDS-TYPE-02).","name":"Interface and reading text"},{"path":"foundations/type-families.card.html","group":"Foundations","viewport":"820x1000","subtitle":"Five faces, one job each. A page downloads only the faces it paints: a Latin-only Nizam page costs 120.6 KB of type.","name":"Type families"},{"path":"foundations/type-headings.card.html","group":"Foundations","viewport":"820x790","subtitle":"Every title is Literata: display and h1 at 500, h2 to h6 at 600. Controls, labels, meta and tables stay in Instrument Sans (MDS-TYPE-03).","name":"Titles — Literata"},{"path":"foundations/type-quran.card.html","group":"Foundations","viewport":"820x1070","subtitle":"Qur'anic text only, at 34/2.25 (28 on a phone), always fully vocalised. An ayah is bound to its end mark, and every waqf sign is drawn in the Qur'an face.","name":"Qur'an — Scheherazade New"},{"path":"foundations/type-scale.card.html","group":"Foundations","viewport":"820x1250","subtitle":"Sizes are role names: pick the role, not the pixel. An Arabic region moves each step up; the matn and the Qur'an never scale with it.","name":"Type scale"},{"path":"components/cover-pattern.card.html","group":"Medrese","viewport":"820x1130","subtitle":"Bookcloth in four tones with a blind stamp; a course hashes to one cloth and keeps it, by day and by night","name":"Cover pattern"},{"path":"components/lesson-row.card.html","group":"Medrese","viewport":"820x1050","subtitle":"A ledger line: the type as glyph and label, drawn neutral; current, done and locked, the title always readable","name":"Lesson row"},{"path":"components/session-join.card.html","group":"Medrese","viewport":"820x1442","subtitle":"Celseye katıl as the one ink button in every session state; the platform as a chip, the link behind a disclosure","name":"Session join"},{"path":"components/week-accordion.card.html","group":"Medrese","viewport":"820x1252","subtitle":"A week of the programme as a heading and a button; every week opens, titles and dates are public","name":"Week accordion"},{"path":"components/sidebar.card.html","group":"Navigation","viewport":"1040x780","subtitle":"One paper sidebar for Nizam and Nazır: sections, items with counts, the current page in a lâciverd tint, the signed-in person at the foot; mirrored in Arabic","name":"Sidebar"},{"path":"components/tabs.card.html","group":"Navigation","viewport":"1100x820","subtitle":"Ink tabs over a lâciverd underline, counts in a pill, a compact row for Nizam's lists; the breadcrumb says where the URL is, and at 390 keeps only the way back","name":"Tabs & breadcrumb"},{"path":"patterns/app-shell.card.html","group":"Patterns","viewport":"1280x1900","subtitle":"The köşk home at desktop: one paper sidebar, a compact main region, the page's one ink action; at 390 the AppBar and its nav sheet take the sidebar's place","name":"App shell — Nizam"},{"path":"patterns/ezber-card.card.html","group":"Patterns","viewport":"820x742","subtitle":"An ezber kartı: Arabic on the front, Turkish on the back, its state at the top edge","name":"Ezber card"},{"path":"patterns/mutalaa.card.html","group":"Patterns","viewport":"1200x1960","subtitle":"The reading sheet: the Qur'an under its sûre band, a matn line with its source, the şerh with a haşiye in the margin","name":"Mütalaa folio"}],"templates":[],"hasThumbnailHtml":true,"globalCssPaths":["tokens
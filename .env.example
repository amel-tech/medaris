# Medaris — the workspace environment template (MDRS-25)
#
# Copy to `.env`, fill in the secrets, then run `pnpm env:sync`. That writes
# `apps/<app>/.env` for all six apps; those files are generated and git-ignored,
# and editing one by hand loses the edit on the next sync.
#
# THIS IS THE ONLY ENV FILE ANYONE EDITS. `apps/<app>/.env.example` is generated
# from this one and committed so the Docker build and CI keep working; CI fails
# when the two disagree.
#
# Key convention — the prefix says who gets the key, and is stripped on the way
# out, so `NIZAM__NEXTAUTH_URL` reaches apps/nizam as plain `NEXTAUTH_URL`:
#
#   KEY=            every app
#   WEB__KEY=       landing, nazir, nizam, tedris   (overrides shared)
#   API__KEY=       tedrisat, teskilat              (overrides shared)
#   TEDRIS__KEY=    that one app                    (overrides both)
#
# Never commit a real secret. The placeholder values below are not usable.

# ---------------------------------------------------------------------------
# Root only — read from this file by docker-compose, never distributed
# ---------------------------------------------------------------------------

TEDRISAT_PORT=3001
TESKILAT_PORT=3002

# docker/init-db.sql creates the tedrisat_db / teskilat_db databases and users.
MEDARIS_POSTGRES_USER=postgres
MEDARIS_POSTGRES_PASSWORD=postgres
MEDARIS_POSTGRES_DB=postgres
MEDARIS_POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Shared by all six apps
# ---------------------------------------------------------------------------
#
# NODE_ENV is deliberately NOT here. `next build` sets it to production itself,
# and a .env that says development while the build runs makes React resolve its
# development bundle against a production SSR runtime — the build dies
# prerendering /_global-error with "Cannot read properties of null (reading
# 'useContext')". Measured: broadcasting it failed all four web builds, and
# moving it to API__ below made them pass again.

# The web apps ship telemetry to the hosted collector; both APIs expect a
# sidecar collector on localhost inside their container. That difference is
# deliberate, which is why it is written as two API__ overrides below rather
# than left to drift between six files.
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.medaris.net:4317

# ---------------------------------------------------------------------------
# The four Next.js apps
# ---------------------------------------------------------------------------
#
# NEXT_PUBLIC_* is inlined into the client bundle at BUILD time, not read at
# runtime. Changing one needs a rebuild, not a restart — and it must never hold
# a secret, because it ships to the browser.

WEB__KEYCLOAK_ISSUER=https://auth.medaris.app/realms/amel-tech-dev
WEB__NEXT_PUBLIC_KEYCLOAK_ISSUER=https://auth.medaris.app/realms/amel-tech-dev

# The tedrisat API listens on 3001. apps/tedris/.env.example named 4001 here,
# which is nizam-web's own port; the value was correct in every other app.
WEB__TEDRISAT_API_BASE_URL=http://localhost:3001
WEB__NEXT_PUBLIC_TEDRISAT_API_BASE_URL=http://localhost:3001
WEB__NEXT_PUBLIC_TEDRIS_APP_URL=http://localhost:4000

# Serve mocked API responses instead of calling the backend.
WEB__API_MOCKING=disabled
WEB__NEXT_PUBLIC_API_MOCKING=disabled

# --- apps/tedris (port 4000) ---
TEDRIS__OTEL_SERVICE_NAME=tedris-web
TEDRIS__NEXTAUTH_URL=http://localhost:4000
TEDRIS__NEXT_PUBLIC_NEXTAUTH_URL=http://localhost:4000
TEDRIS__KEYCLOAK_CLIENT_ID=tedris-dev
TEDRIS__NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=tedris-dev
TEDRIS__KEYCLOAK_CLIENT_SECRET=set-me-per-machine
# One distinct secret per app. MDRS-24 was in part this key matching across two
# apps; nazir and nizam still hold the same value on developer machines today,
# and one app's Keycloak client secret had been pasted in as another's. Generate
# each with `openssl rand -base64 32` and do not copy one into another slot.
TEDRIS__NEXTAUTH_SECRET=set-me-per-machine

# --- apps/nizam (port 4001) ---
NIZAM__OTEL_SERVICE_NAME=nizam-web
NIZAM__NEXTAUTH_URL=http://localhost:4001
NIZAM__NEXT_PUBLIC_NEXTAUTH_URL=http://localhost:4001
NIZAM__KEYCLOAK_CLIENT_ID=nizam-dev
NIZAM__NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=nizam-dev
NIZAM__KEYCLOAK_CLIENT_SECRET=set-me-per-machine
NIZAM__NEXTAUTH_SECRET=set-me-per-machine

# --- apps/nazir (port 4002) ---
NAZIR__OTEL_SERVICE_NAME=nazir-web
NAZIR__NEXTAUTH_URL=http://localhost:4002
NAZIR__NEXT_PUBLIC_NEXTAUTH_URL=http://localhost:4002
NAZIR__KEYCLOAK_CLIENT_ID=nazir-dev
NAZIR__NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=nazir-dev
NAZIR__KEYCLOAK_CLIENT_SECRET=set-me-per-machine
NAZIR__NEXTAUTH_SECRET=set-me-per-machine

# --- apps/landing (no auth) ---
LANDING__OTEL_SERVICE_NAME=landing-web

# ---------------------------------------------------------------------------
# The two NestJS APIs
# ---------------------------------------------------------------------------

API__NODE_ENV=development
API__LOG_LEVEL=info
API__ALLOWED_ORIGINS=*
API__ALLOWED_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE

API__SWAGGER_ENABLED=true
API__SWAGGER_PATH=/docs

# Host-side defaults. docker-compose overrides DB_HOST to the service name for
# the containers it starts.
API__DB_HOST=localhost
API__DB_PORT=5432
API__DB_SSL=false
# With DB_SSL=true the server certificate is verified. Set DB_CA_CERT to a PEM
# bundle when the database presents a private-CA or self-signed certificate.
# API__DB_CA_CERT=

# A sidecar collector, not the hosted endpoint the web apps use.
API__OTEL_ENABLED=true
API__OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
API__OTEL_EXPORTER_OTLP_INSECURE=true
API__OTEL_EXPORTER_OTLP_PROTOCOL=grpc
API__OTEL_EXPORTER_OTLP_COMPRESSION=gzip

API__AUTO_MIGRATIONS_ENABLED=true
API__AUTO_MIGRATIONS_FOLDER=./src/database/migrations

API__KEYCLOAK_JWKS_URL=https://auth.medaris.app/realms/amel-tech-dev/protocol/openid-connect/certs

# --- apps/tedrisat (port 3001) ---
TEDRISAT__PORT=3001
TEDRISAT__SERVICE_NAME=tedrisat-service
TEDRISAT__DB_NAME=tedrisat_db
TEDRISAT__DB_USERNAME=tedrisat
# Required outside NODE_ENV=test — the service refuses to boot without it
# rather than falling back to docker/init-db.sql's credential.
TEDRISAT__DB_PASSWORD=change-me
# Carried over verbatim: tedrisat authenticates against the tedris-web client
# rather than one of its own. MDRS-42 is where that gets a per-app client.
TEDRISAT__KEYCLOAK_CLIENT_ID=tedris-dev
TEDRISAT__KEYCLOAK_REDIRECT_URL=https://api-tedrisat-dev.medaris.net

# --- apps/teskilat (port 3002) ---
TESKILAT__PORT=3002
TESKILAT__SERVICE_NAME=teskilat-service
TESKILAT__DB_NAME=teskilat_db
TESKILAT__DB_USERNAME=teskilat
TESKILAT__DB_PASSWORD=change-me

# Medaris — example environment
#
# Copy to .env and adjust. This file is the workspace-level template used by
# docker-compose; each Nest app additionally reads its own apps/<app>/.env,
# which is git-ignored. Never commit real secrets.

# ---------------------------------------------------------------------------
# Shared — docker-compose
# ---------------------------------------------------------------------------

# App ports
TEDRISAT_PORT=3001
TESKILAT_PORT=3002

# Database container (docker compose up -d medaris-db)
# docker/init-db.sql creates the tedrisat_db / teskilat_db databases and users.
MEDARIS_POSTGRES_USER=postgres
MEDARIS_POSTGRES_PASSWORD=postgres
MEDARIS_POSTGRES_DB=postgres
MEDARIS_POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Backend — apps/tedrisat, apps/teskilat (NestJS)
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3001
SERVICE_NAME=tedrisat

# Database connection
# apps/tedrisat requires DB_PASSWORD, KEYCLOAK_JWKS_URL, KEYCLOAK_ISSUER and
# KEYCLOAK_AUDIENCE outside NODE_ENV=test; it exits with a message naming the
# variable instead of falling back to a built-in default.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tedrisat_db
DB_USERNAME=tedrisat
DB_PASSWORD=change-me
DB_SSL=false
# With DB_SSL=true the server certificate is verified. Set DB_CA_CERT to a PEM
# bundle for a private-CA or self-signed certificate.
# DB_CA_CERT=

# Migrations run at boot
AUTO_MIGRATIONS_ENABLED=true
AUTO_MIGRATIONS_FOLDER=./dist/database/migrations

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Keycloak token validation
KEYCLOAK_JWKS_URL=https://auth.example.org/realms/medaris/protocol/openid-connect/certs
# Expected `iss` — the realm URL — and expected `aud`. Both are checked on
# every token; without them the API would accept any token the realm signed.
KEYCLOAK_ISSUER=https://auth.example.org/realms/medaris
KEYCLOAK_AUDIENCE=tedrisat-api
# Optional comma-separated `azp` allow-list. Empty means no `azp` restriction.
# KEYCLOAK_ALLOWED_CLIENTS=tedris-web,nizam-web,nazir-web
KEYCLOAK_CACHE_TTL=3600
KEYCLOAK_NOT_FOUND_CACHE_TTL=60

# CORS
ALLOWED_ORIGINS=http://localhost:4000,http://localhost:4001,http://localhost:4002,http://localhost:4003
ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS

# Logging
LOGGER_TYPE=pino
LOG_LEVEL=debug
LOG_FORMAT=pretty

# Swagger
SWAGGER_ENABLED=true
SWAGGER_PATH=docs
SWAGGER_ENDPOINT=/docs

# OpenTelemetry — defaults to enabled and expects a collector on 4317.
# With no collector running this is only log noise; keep it false locally.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ---------------------------------------------------------------------------
# Frontend — apps/tedris, apps/nizam, apps/nazir, apps/landing (Next.js)
# ---------------------------------------------------------------------------
#
# NEXT_PUBLIC_* values are inlined at BUILD time, not read at runtime.
# Changing one requires a rebuild, not a restart.

NEXT_PUBLIC_TEDRISAT_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_TEDRIS_APP_URL=http://localhost:4000

# Keycloak points at a real server; auth flows will not complete locally,
# but pages still render.
NEXT_PUBLIC_KEYCLOAK_ISSUER=https://auth.example.org/realms/medaris
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=medaris-web
NEXT_PUBLIC_NEXTAUTH_URL=http://localhost:4000

# Serve mocked API responses instead of calling the backend
NEXT_PUBLIC_API_MOCKING=disabled

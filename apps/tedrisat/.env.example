NODE_ENV=development
PORT=3001
SERVICE_NAME=tedrisat-service
LOG_LEVEL=info

# CORS
ALLOWED_ORIGINS=*
ALLOWED_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE

# Swagger
SWAGGER_ENABLED=true
SWAGGER_PATH=/docs

# Database
# DB_PASSWORD is required outside NODE_ENV=test — the service refuses to boot
# without it rather than falling back to docker/init-db.sql's credential.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=tedrisat
DB_PASSWORD=change-me
DB_NAME=tedrisat_db
DB_SSL=false
# With DB_SSL=true the server certificate is verified. Set DB_CA_CERT to a PEM
# bundle when the database presents a private-CA or self-signed certificate.
# DB_CA_CERT=

# OTEL
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317 # otell-collector for container
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_COMPRESSION=gzip

# Auto Migrations
AUTO_MIGRATIONS_ENABLED=true
AUTO_MIGRATIONS_FOLDER=./src/database/migrations

# Keycloack
# KEYCLOAK_JWKS_URL, KEYCLOAK_ISSUER and KEYCLOAK_AUDIENCE are all required
# outside NODE_ENV=test. The verifier checks `iss` and `aud` on every token, so
# a missing value is a boot failure rather than a silently skipped check.
KEYCLOAK_JWKS_URL=https://auth.medaris.app/realms/amel-tech-dev/protocol/openid-connect/certs
# The realm URL, exactly as it appears in the token's `iss` claim.
KEYCLOAK_ISSUER=https://auth.medaris.app/realms/amel-tech-dev
# The client this API is registered as. Comma-separated when the realm mints
# more than one acceptable audience; the token must carry at least one.
KEYCLOAK_AUDIENCE=tedrisat-api
# Optional comma-separated `azp` allow-list — the front-end clients allowed to
# obtain a token for this API. Empty means no `azp` restriction; `aud` already
# binds the token to this API.
# KEYCLOAK_ALLOWED_CLIENTS=tedris-web,nizam-web,nazir-web
KEYCLOAK_CLIENT_ID="tedris-dev"
KEYCLOAK_REDIRECT_URL="https://api-tedrisat-dev.medaris.net"

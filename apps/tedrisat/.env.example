NODE_ENV=development
PORT=3001
SERVICE_NAME=tedrisat-service
LOG_LEVEL=info

# CORS
# Comma-separated absolute origins. The web apps run on 4000 (tedris),
# 4001 (nizam), 4002 (nazir) and 4003 (landing). Outside NODE_ENV=production an
# unset list and `*` both mean "any origin"; under NODE_ENV=production either
# one refuses the boot, so a deployment has to name its origins.
ALLOWED_ORIGINS=http://localhost:4000,http://localhost:4001,http://localhost:4002,http://localhost:4003
# OPTIONS is added to whatever is listed here — a preflight has to advertise it.
ALLOWED_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE,OPTIONS

# Swagger
SWAGGER_ENABLED=true
SWAGGER_PATH=/docs

# Database
# DB_PASSWORD is required outside NODE_ENV=test — the service refuses to boot
# without it rather than falling back to docker/init-db.sql's credential.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=tedrisat
DB_PASSWORD=change-me
DB_NAME=tedrisat_db
DB_SSL=false
# With DB_SSL=true the server certificate is verified. Set DB_CA_CERT to a PEM
# bundle when the database presents a private-CA or self-signed certificate.
# DB_CA_CERT=

# OTEL
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317 # otell-collector for container
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_COMPRESSION=gzip

# Auto Migrations
AUTO_MIGRATIONS_ENABLED=true
AUTO_MIGRATIONS_FOLDER=./src/database/migrations

# Keycloack
KEYCLOAK_JWKS_URL=https://auth.medaris.app/realms/amel-tech-dev/protocol/openid-connect/certs
KEYCLOAK_CLIENT_ID="tedris-dev"
KEYCLOAK_REDIRECT_URL="https://api-tedrisat-dev.medaris.net"

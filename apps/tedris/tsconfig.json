{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "incremental": true,
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "strict": false,
    "target": "ES2017",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "allowJs": true,
    "jsx": "preserve",
    "noEmit": true,
    "paths": {
      "~/env": [
        "./env.ts"
      ],
      "~/features/*": [
        "./features/*"
      ],
      "~/components/*": [
        "./components/*"
      ],
      "~/lib/*": [
        "./lib/*"
      ],
      "~/hooks": [
        "./hooks"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next/**"
  ]
}

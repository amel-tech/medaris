{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "landing-web",
  "targets": {
    "lint": {},
    "build": {
      "inputs": [
        "production",
        "^production",
        {
          "env": "NEXT_PUBLIC_TEDRIS_APP_URL"

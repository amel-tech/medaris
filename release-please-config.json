{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "separate-pull-requests": false,
  "group-pull-request-title-pattern": "chore(repo): release ${branch}",
  "pull-request-header": "Release for Medaris",
  "packages": {
    "apps/tedrisat": {
      "release-type": "node",
      "package-name": "tedrisat",
      "include-component-in-tag": true,
      "pull-request-title-pattern": "chore(tedrisat): release ${version}",
      "component": "tedrisat",
      "path": "apps/tedrisat"
    },
    "apps/teskilat": {
      "release-type": "node",
      "package-name": "teskilat",
      "include-component-in-tag": true,
      "pull-request-title-pattern": "chore(teskilat): release ${version}",
      "component": "teskilat",
      "path": "apps/teskilat"
    },
    "apps/tedris": {
      "release-type": "node",
      "package-name": "tedris-web",
      "include-component-in-tag": true,
      "pull-request-title-pattern": "chore(tedris-web): release ${version}",
      "component": "tedris-web",
      "path": "apps/tedris"
    },
    "apps/nizam": {
      "release-type": "node",
      "package-name": "nizam-web",
      "include-component-in-tag": true,
      "pull-request-title-pattern": "chore(nizam-web): release ${version}",
      "component": "nizam-web",
      "path": "apps/nizam"
    },
    "apps/nazar": {
      "release-type": "node",
      "package-name": "nazar-web",
      "include-component-in-tag": true,
      "pull-request-title-pattern": "chore(nazar-web): release ${version}",
      "component": "nazar-web",
      "path": "apps/nazar"
    },
    "apps/landing": {
      "release-type": "node",
      "package-name": "landing-web",
      "include-component-in-tag": true,
      "pull-request-title-pattern": "chore(landing-web): release ${version}",
      "component": "landing-web",
      "path": "apps/landing"
    },
    "apps/keycloak-theme": {
      "release-type": "node",
      "package-name": "keycloak-theme",
      "include-component-in-tag": true,
      "pull-request-title-pattern": "chore(keycloak-theme): release ${version}",
      "component": "keycloak-theme",
      "path": "apps/keycloak-theme"
    }
  }
}

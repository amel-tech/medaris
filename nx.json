{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "analytics": false,
  "neverConnectToCloud": true,
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)",
      "!{projectRoot}/test/**/*",
      "!{projectRoot}/vitest.config.ts",
      "!{projectRoot}/vitest.integration.config.ts",
      "!{projectRoot}/**/*.stories.@(js|jsx|ts|tsx|mdx)",
      "!{projectRoot}/.storybook/**/*",
      "!{projectRoot}/CHANGELOG.md",
      "!{projectRoot}/README.md"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/pnpm-workspace.yaml",
      "{workspaceRoot}/pnpm-lock.yaml",
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/tsconfig.json",
      "{workspaceRoot}/.nvmrc",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/.github/workflows/ci.yaml",
      "{workspaceRoot}/vitest.config.ts",
      "{workspaceRoot}/vitest.integration.config.ts",
      "{workspaceRoot}/tools/env/**",
      {
        "runtime": "cat .env .env*.local apps/*/.env*.local 2>/dev/null | shasum"
      }
    ]
  },
  "plugins": [
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "module-boundaries"
      }
    }
  ],
  "targetDefaults": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "biome check {projectRoot}"
      },
      "cache": true,
      "inputs": ["default", "{workspaceRoot}/biome.json"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist"],
      "cache": true
    },
    "typecheck": {
      "dependsOn": ["^build", "^typecheck"],
      "inputs": ["default", "^production"],
      "outputs": [
        "{projectRoot}/.tsbuild",
        "{projectRoot}/tsconfig.tsbuildinfo"
      ],
      "cache": true
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["default", "^production"],
      "outputs": ["{projectRoot}/coverage", "{projectRoot}/test-results"],
      "cache": true
    },
    "depcheck": {
      "cache": true,
      "inputs": ["default", "{workspaceRoot}/.depcheckrc.json"]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "inputs": ["default", "^production"],
      "outputs": ["{projectRoot}/coverage"],
      "cache": true
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "inputs": ["default", "^production"],
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "continuous": true
    },
    "start": {
      "dependsOn": ["^build", "build"],
      "cache": false,
      "continuous": true
    },
    "start:dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "continuous": true
    },
    "start:debug": {
      "dependsOn": ["^build"],
      "cache": false,
      "continuous": true
    },
    "start:prod": {
      "dependsOn": ["build"],
      "cache": false,
      "continuous": true
    },
    "storybook": {
      "dependsOn": ["^build"],
      "cache": false,
      "continuous": true
    },
    "run-keycloak": {
      "cache": false,
      "continuous": true
    },
    "dev:tedrisat": {
      "cache": false,
      "continuous": true
    },
    "db:migrate": {
      "dependsOn": ["db:generate"],
      "cache": false
    }
  }
}

{
  "clientId": "nazir-local",
  "name": "nazir (local)",
  "standardFlowEnabled": true,
  "baseUrl": "http://localhost:4002",
  "redirectUris": ["http://localhost:4002/api/auth/callback/keycloak"],
  "webOrigins": ["http://localhost:4002"],
  "attributes": {
    "pkce.code.challenge.method": "S256",
    "post.logout.redirect.uris": "http://localhost:4002##http://localhost:4002/"
  },
  "protocolMappers": [
    {
      "name": "audience-tedrisat-api",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-audience-mapper",
      "consentRequired": false,
      "config": {
        "included.client.audience": "tedrisat-api",
        "access.token.claim": "true",
        "id.token.claim": "false",
        "introspection.token.claim": "true"
      }
    }
  ]
}

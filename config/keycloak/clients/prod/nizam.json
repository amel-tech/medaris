{
  "clientId": "nizam",
  "name": "nizam",
  "standardFlowEnabled": true,
  "frontchannelLogout": false,
  "baseUrl": "https://nizam.medaris.app",
  "redirectUris": ["https://nizam.medaris.app/api/auth/callback/keycloak"],
  "webOrigins": ["https://nizam.medaris.app"],
  "defaultClientScopes": ["gender"],
  "attributes": {
    "pkce.code.challenge.method": "S256",
    "post.logout.redirect.uris": "https://nizam.medaris.app##https://nizam.medaris.app/",
    "backchannel.logout.url": "https://nizam.medaris.app/api/auth/backchannel-logout",
    "backchannel.logout.session.required": "true",
    "backchannel.logout.revoke.offline.tokens": "false"
  },
  "protocolMappers": [
    {
      "name": "audience-tedrisat-api",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-audience-mapper",
      "consentRequired": false,
      "config": {
        "included.client.audience": "tedrisat-api",
        "access.token.claim": "true",
        "id.token.claim": "false",
        "introspection.token.claim": "true"
      }
    }
  ]
}

# config/keycloak/env/local.env.example — MDRS-97.
# A Keycloak on this machine, e.g.
#   docker run -p 127.0.0.1:8080:8080 -e KC_BOOTSTRAP_ADMIN_USERNAME=admin \
#     -e KC_BOOTSTRAP_ADMIN_PASSWORD=admin quay.io/keycloak/keycloak:26.3.2 start-dev
# Against http://localhost the admin credentials default to admin/admin.
# Copy to env/local.env (git-ignored) and `set -a; . <file>; set +a`.

KC_URL=http://localhost:8080
KC_REALM=medaris

KC_ADMIN_USER=
KC_ADMIN_PASSWORD=

KC_CLIENT_SECRET_TEDRIS_LOCAL=
KC_CLIENT_SECRET_NIZAM_LOCAL=
KC_CLIENT_SECRET_NAZAR_LOCAL=

# A local mail catcher such as Mailpit on the same Docker network as Keycloak.
# Plain SMTP with credentials needs ALLOW_INSECURE_SMTP=1.
KC_SMTP_HOST=
KC_SMTP_SECURITY=none
KC_SMTP_PORT=1025
KC_SMTP_FROM=no-reply@medaris.test
KC_SMTP_FROM_DISPLAY_NAME=Medaris
KC_SMTP_USER=
KC_SMTP_PASSWORD=

# config/keycloak/env/prod.env.example — MDRS-97.
# What config/keycloak/scripts/{provision,dry-run,verify} prod read. Copy to
# env/prod.env (git-ignored), fill the empty values from the secret store, then
#   set -a; . config/keycloak/env/prod.env; set +a
# Never commit a filled copy; `validate` fails on a value in a *_SECRET or
# *_PASSWORD line of this file.

KC_URL=https://auth.medaris.app
KC_REALM=medaris
ALLOW_REMOTE=1

# A master-realm admin allowed to manage realms.
KC_ADMIN_USER=
KC_ADMIN_PASSWORD=

# Client secrets. Empty: an existing client keeps its secret, a new one gets
# one generated by Keycloak (read it from the admin console, Credentials tab).
KC_CLIENT_SECRET_TEDRIS=
KC_CLIENT_SECRET_NIZAM=
KC_CLIENT_SECRET_NAZAR=

# Mail sender (MDRS-98). Without KC_SMTP_HOST the realm cannot send the
# verification e-mail, and registration cannot finish.
KC_SMTP_HOST=
KC_SMTP_SECURITY=ssl
KC_SMTP_PORT=
KC_SMTP_FROM=no-reply@medaris.app
KC_SMTP_FROM_DISPLAY_NAME=Medaris
KC_SMTP_REPLY_TO=
KC_SMTP_ENVELOPE_FROM=
KC_SMTP_USER=
KC_SMTP_PASSWORD=

{
  "name": "@medaris/source",
  "version": "0.0.0",
  "private": true,
  "description": "Medaris monorepo — 7 apps, 9 libs, one pnpm workspace",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "nx run-many -t build",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "dev": "nx run-many -t dev",
    "lint": "nx run-many -t lint",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "module-boundaries": "nx run-many -t module-boundaries",
    "affected": "nx affected -t typecheck test build lint module-boundaries",
    "graph": "nx graph"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@nx/eslint": "catalog:",
    "@nx/eslint-plugin": "catalog:",
    "eslint": "catalog:",
    "nx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}

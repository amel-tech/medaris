{
  "name": "@medaris/source",
  "version": "0.0.0",
  "private": true,
  "description": "Medaris monorepo — 7 apps, 9 libs, one pnpm workspace",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "pnpm env:sync && nx run-many -t build",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "dev": "pnpm env:sync && nx run-many -t dev",
    "env:sync": "node tools/env/sync-env.mjs",
    "env:check": "node tools/env/sync-env.mjs --check --examples",
    "env:collect": "node tools/env/sync-env.mjs --collect",
    "lint": "nx run-many -t lint",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "module-boundaries": "nx run-many -t module-boundaries",
    "lint:root": "node tools/ci/biome-ratchet.mjs",
    "assert:affected-isolation": "node tools/ci/assert-affected-isolation.mjs",
    "assert:traceability": "node tools/ci/assert-traceability.mjs",
    "reconcile:linear": "node tools/ci/reconcile-linear.mjs",
    "audit:ci": "audit-ci --config ./audit-ci.json",
    "depcheck": "nx run-many -t depcheck",
    "security-check": "pnpm run audit:ci && pnpm run depcheck",
    "affected": "nx affected -t typecheck test build lint module-boundaries",
    "graph": "nx graph",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs,json,jsonc,css}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@nx/eslint": "catalog:",
    "@nx/eslint-plugin": "catalog:",
    "audit-ci": "catalog:",
    "depcheck": "catalog:",
    "eslint": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "nx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}

{
  "name": "@medaris/common",
  "version": "0.0.0",
  "description": "Common DTOs and utilities for Madrasah services",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run build",
    "audit": "pnpm audit",
    "audit:ci": "audit-ci --config ../../audit-ci.json",
    "depcheck": "depcheck --config=../../.depcheckrc.json"
  },
  "keywords": [
    "madrasah",
    "dto",
    "common"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/swagger": "catalog:",
    "@nestjs/throttler": "catalog:",
    "class-transformer": "catalog:",
    "class-validator": "catalog:",
    "compression": "catalog:",
    "exceljs": "catalog:",
    "helmet": "catalog:",
    "jose": "catalog:",
    "pino": "catalog:",
    "pino-pretty": "catalog:",
    "winston": "catalog:"
  },
  "devDependencies": {
    "@types/compression": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:vitest",
    "vitest": "catalog:"
  },
  "private": true
}

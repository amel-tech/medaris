{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "tokens",
  "tags": ["scope:ui", "platform:web", "type:ui"],
  "targets": {
    "lint": {},
    "build": {
      "outputs": ["{projectRoot}/theme/main.css"]
    },
    "process": {
      "outputs": ["{projectRoot}/theme/main.css"]
    },
    "test": {
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/libs/ui/styles/theme.css",
        "{workspaceRoot}/libs/ui/package.json",
        {
          "runtime": "cat design-system/tokens/*.css"
        }
      ]
    }
  }
}

{
  "name": "@medaris/tokens",
  "version": "0.0.0",
  "description": "Design tokens package for Madrasah projects",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "import": "./index.js",
      "types": "./index.d.ts"
    },
    "./css": "./theme/index.css"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "theme/*.css",
    "build/*"
  ],
  "scripts": {
    "build": "pnpm run process && node scripts/build.js",
    "process": "node scripts/process-tokens.js",
    "clean": "rm -rf .turbo node_modules dist coverage",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "tailwindcss": "catalog:",
    "vitest": "catalog:"
  },
  "keywords": [
    "design-tokens",
    "tailwindcss",
    "css-variables",
    "theme"
  ],
  "private": true
}

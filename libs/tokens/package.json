{
  "name": "@medaris/tokens",
  "version": "0.0.0",
  "description": "Design tokens package for Madrasah projects",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "import": "./index.js",
      "types": "./index.d.ts"
    },
    "./css": "./theme/main.css"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "theme/main.css",
    "build/*"
  ],
  "scripts": {
    "build": "pnpm run process && node scripts/build.js",
    "process": "node scripts/process-tokens.js",
    "clean": "rm -rf .turbo node_modules dist",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "catalog:"
  },
  "keywords": [
    "design-tokens",
    "tailwindcss",
    "css-variables",
    "theme"
  ],
  "private": true
}

{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "isolatedModules": false,
    "lib": [
      "ESNext",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "./.tsbuild",
    "composite": true,
    "incremental": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "rootDir": "./src",
    "tsBuildInfoFile": "./.tsbuild/.tsbuildinfo"
  },
  "include": [
    "src/**/*",
    "src/**/*.json"
  ],
  "exclude": [
    "node_modules"
  ]
}

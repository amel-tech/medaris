{
  "editor.defaultFormatter": "biomejs.biome",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.biome": "always",
    "source.organizeImports.biome": "always"
  },
  "[typescript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[javascript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[json]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[css]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "typescript.tsdk": "node_modules/typescript/lib",
  "i18n-ally.localesPaths": "libs/i18n/src/locales",
  "i18n-ally.namespace": true,
  "i18n-ally.enabledFrameworks": ["next-intl"],
  "i18n-ally.pathMatcher": "{locale}/{namespaces}.json",
  "i18n-ally.keystyle": "nested",
  "i18n-ally.sourceLanguage": "en",
  "yaml.schemas": {
    "https://unpkg.com/@delurio/cli@0.2.0/schemas/flow.schema.json": "graphs/**/flow.yaml",
    "https://unpkg.com/@delurio/cli@0.2.0/schemas/ui.schema.json": "graphs/**/ui.yaml",
    "https://unpkg.com/@delurio/cli@0.2.0/schemas/nav.schema.json": [
      "graphs/**/nav.yaml",
      "graphs/**/nav.extracted.yaml"
    ],
    "https://unpkg.com/@delurio/cli@0.2.0/schemas/domain.schema.json": "graphs/**/domain.yaml"
  },
  "json.schemas": [
    {
      "fileMatch": ["graphs/**/catalog/*.json"],
      "url": "https://unpkg.com/@delurio/cli@0.2.0/schemas/catalog.schema.json"
    }
  ]
}
